{
  "name": "zhitai-workbench",
  "productName": "织台",
  "version": "0.2.0-alpha.1",
  "private": true,
  "main": "desktop/main.js",
  "description": "本地优先的内容采集、知识库、分析与多平台发布工作台。",
  "keywords": [
    "content-automation",
    "local-first",
    "workbench",
    "zhitai"
  ],
  "homepage": "https://github.com/lt750965698-cyber/zhitai-workbench#readme",
  "bugs": {
    "url": "https://github.com/lt750965698-cyber/zhitai-workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lt750965698-cyber/zhitai-workbench.git"
  },
  "license": "MIT",
  "author": "lt750965698-cyber",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:start": "pnpm run build && pnpm run build:desktop-assets && electron-forge start",
    "build:desktop-assets": "node scripts/build-desktop-assets.mjs",
    "package:desktop": "pnpm run build && pnpm run build:desktop-assets && electron-forge package",
    "make:windows": "pnpm run build:desktop-assets && electron-forge make --platform=win32 --arch=x64",
    "smoke:windows-package": "node scripts/smoke-packaged-windows.mjs",
    "agent": "node local-agent/server.mjs",
    "backup": "node --disable-warning=ExperimentalWarning local-agent/backup-cli.mjs",
    "test:backup": "node --test --test-timeout=15000 tests/backup-recovery.test.mjs tests/backup-security.test.mjs tests/platform-receipts.test.mjs",
    "test": "pnpm run build && pnpm run test:node && pnpm run test:integrations",
    "test:node": "node scripts/test-node.mjs",
    "test:integrations": "node scripts/test-integrations.mjs",
    "test:agent": "node --test tests/local-agent.integration.test.mjs",
    "test:ops": "node --test tests/operations-experiment-review.test.mjs tests/operations-metrics-contract.test.mjs tests/operations-report.test.mjs tests/operations-schema-validation.test.mjs",
    "report:ops:synthetic": "node scripts/operations-report.mjs --synthetic --format markdown",
    "test:offline-e2e": "node --import ./tests/e2e/network-lockdown.mjs scripts/run-offline-e2e.mjs",
    "test:windows": "node --test tests/desktop-platform.test.mjs tests/platform-capabilities.test.mjs tests/platform-utils.test.mjs tests/windows-desktop-runtime.test.mjs tests/windows-local-agent.integration.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electron/asar": "4.3.0",
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "electron": "43.2.0",
    "globals": "16.4.0",
    "png-to-ico": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
