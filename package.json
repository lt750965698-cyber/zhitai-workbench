{
  "name": "zhitai-workbench",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "本地优先的内容采集、知识库、分析与多平台发布工作台。",
  "keywords": [
    "content-automation",
    "local-first",
    "workbench",
    "zhitai"
  ],
  "homepage": "https://github.com/lt750965698-cyber/zhitai-workbench#readme",
  "bugs": {
    "url": "https://github.com/lt750965698-cyber/zhitai-workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lt750965698-cyber/zhitai-workbench.git"
  },
  "license": "MIT",
  "author": "lt750965698-cyber",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "agent": "node local-agent/server.mjs",
    "test": "pnpm run build && pnpm run test:node && pnpm run test:integrations",
    "test:node": "node --test tests/*.test.mjs",
    "test:integrations": "node scripts/test-integrations.mjs",
    "test:agent": "node --test tests/local-agent.integration.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electron/asar": "4.3.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.0.16",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
