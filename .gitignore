# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/desktop/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.artifacts/
/.nyc_output/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
*.log
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and package-registry credentials
.env*
!.env.example
!.env.*.example
.npmrc
.netrc
credentials*.json
secrets*.json
service-account*.json
!credentials.example.json
!secrets.example.json
!service-account.example.json

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# local Sites deployment identity (copy the safe example when needed)
/.openai/hosting.json

# runtime databases and operation journals
/operations/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3

# local companion state and secrets
/local-agent/config.local.json
/local-agent/data/
/local-agent/yuanbao-cookie
/local-agent/inbox-secret
/local-agent/*.secret
/local-agent/*.cookie
/local-agent/*-cookie

# generated/local-only userscripts whose bundled upstream code is not licensed
**/zhitai-kuaidian-bridge.user.js
**/zhitai-edge-all-in-one.user.js

# local workbench/editor state and generated audit artifacts
/.workbuddy/
/.tmp-*
