+const (
+	aiContentDeclarationPlaceholder = "添加内容类型声明"
+	aiContentDeclarationText        = "笔记含AI合成内容"
+)
+
+// setAIContentDeclaration 使用小红书当前的 d-select 原生控件选择
+// “笔记含AI合成内容”，并从同一个表单控件回读选中值。任何一步不确定都失败关闭。
+func setAIContentDeclaration(page *rod.Page) error {
+	extra, err := page.Timeout(15 * time.Second).Element(".publish-page-content-content-extra")
+	if err != nil {
+		return errors.Wrap(err, "未找到内容设置区域")
+	}
+	if err := extra.ScrollIntoView(); err != nil {
+		return errors.Wrap(err, "内容设置区域滚动失败")
+	}
+	time.Sleep(300 * time.Millisecond)
+
+	declarationWrapper, selected, err := findAIContentDeclarationWrapper(extra)
+	if err != nil {
+		return err
+	}
+	if selected {
+		confirmAIContentDeclarationPreview(page)
+		return nil
+	}
+	if declarationWrapper == nil {
+		return errors.New("未找到可见的内容类型声明下拉框")
+	}
+
+	declarationControl, err := visibleChildOrSelf(declarationWrapper, ".d-select-content")
+	if err != nil {
+		return errors.Wrap(err, "定位内容类型声明下拉控件失败")
+	}
+	if blocked, blockedErr := isElementBlocked(declarationControl); blockedErr != nil {
+		return errors.Wrap(blockedErr, "检查内容类型声明下拉控件遮挡状态失败")
+	} else if blocked {
+		return errors.New("内容类型声明下拉控件被遮挡")
+	}
+	// 交互严格走 go-rod 元素的真实鼠标事件，不用脚本派发 click/change。
+	if err := declarationControl.Click(proto.InputMouseButtonLeft, 1); err != nil {
+		return errors.Wrap(err, "打开内容类型声明下拉框失败")
+	}
+
+	aiOption, err := waitForAIContentDeclarationOption(page, 5*time.Second)
+	if err != nil {
+		return err
+	}
+	if blocked, blockedErr := isElementBlocked(aiOption); blockedErr != nil {
+		return errors.Wrap(blockedErr, "检查AI合成内容选项遮挡状态失败")
+	} else if blocked {
+		return errors.New("笔记含AI合成内容选项被遮挡")
+	}
+	// 点击承载组件监听器的完整 d-option-content，而不是里面的文字 span。
+	if err := aiOption.Click(proto.InputMouseButtonLeft, 1); err != nil {
+		return errors.Wrap(err, "选择笔记含AI合成内容失败")
+	}
+
+	// 平台会异步更新原 d-select-wrapper。只有同一个控件的 description 精确
+	// 命中且“添加内容类型声明”占位符消失，才算业务选中态生效。
+	verifyDeadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(verifyDeadline) {
+		if selectedAIContentDeclaration(page, extra) {
+			return nil
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	return errors.New("AI合成内容声明未能回读确认")
+}
+
+func findAIContentDeclarationWrapper(extra *rod.Element) (*rod.Element, bool, error) {
+	wrappers, err := extra.Elements(".d-select-wrapper")
+	if err != nil {
+		return nil, false, errors.Wrap(err, "查找内容类型声明下拉框失败")
+	}
+	for _, wrapper := range wrappers {
+		descriptions, descriptionErr := wrapper.Elements(".d-select-description")
+		if descriptionErr != nil {
+			continue
+		}
+		selected := hasVisibleExactText(descriptions, aiContentDeclarationText)
+
+		placeholders, placeholderErr := wrapper.Elements(".d-select-placeholder")
+		if placeholderErr != nil {
+			continue
+		}
+		placeholderFound := hasVisibleContainingText(placeholders, "内容类型声明")
+		placeholderCleared := !hasVisibleContainingText(placeholders, aiContentDeclarationPlaceholder)
+		if selected && placeholderCleared {
+			return wrapper, true, nil
+		}
+		if placeholderFound {
+			return wrapper, false, nil
+		}
+	}
+	return nil, false, nil
+}
+
+func visibleChildOrSelf(parent *rod.Element, selector string) (*rod.Element, error) {
+	children, err := parent.Elements(selector)
+	if err == nil {
+		for _, child := range children {
+			if isElementVisible(child) {
+				return child, nil
+			}
+		}
+	}
+	if isElementVisible(parent) {
+		return parent, nil
+	}
+	return nil, errors.New("目标控件不可见")
+}
+
+func waitForAIContentDeclarationOption(page *rod.Page, maxWait time.Duration) (*rod.Element, error) {
+	deadline := time.Now().Add(maxWait)
+	for time.Now().Before(deadline) {
+		// 下拉菜单由 portal 挂在 body；真实事件路径显示监听器所在节点是
+		// d-option-content，因此直接锁定完整选项元素。
+		options, err := page.Elements(".d-option-content")
+		if err == nil {
+			for _, option := range options {
+				text, textErr := option.Text()
+				if textErr == nil && isElementVisible(option) && strings.TrimSpace(text) == aiContentDeclarationText {
+					return option, nil
+				}
+			}
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	return nil, errors.New("未找到笔记含AI合成内容选项")
+}
+
+func hasVisibleExactText(elements []*rod.Element, expected string) bool {
+	for _, element := range elements {
+		text, err := element.Text()
+		if err == nil && isElementVisible(element) && strings.TrimSpace(text) == expected {
+			return true
+		}
+	}
+	return false
+}
+
+func hasVisibleContainingText(elements []*rod.Element, expected string) bool {
+	for _, element := range elements {
+		text, err := element.Text()
+		if err == nil && isElementVisible(element) && strings.Contains(strings.TrimSpace(text), expected) {
+			return true
+		}
+	}
+	return false
+}
+
+func selectedAIContentDeclaration(page *rod.Page, extra *rod.Element) bool {
+	_, selected, err := findAIContentDeclarationWrapper(extra)
+	if err != nil || !selected {
+		return false
+	}
+	confirmAIContentDeclarationPreview(page)
+	return true
+}
+
+func confirmAIContentDeclarationPreview(page *rod.Page) {
+	indicators, err := page.Elements(".permission-info-declaration .permission-info-text")
+	if err == nil && hasVisibleExactText(indicators, aiContentDeclarationText) {
+		slog.Info("AI合成内容声明预览角标已确认")
+	}
+}
