+// PrePublishError proves that the publish button was not clicked. Callers may
+// safely retry this class of failure without risking a duplicate public note.
+type PrePublishError struct {
+	err    error
+	reason string
+}
+
+func (e *PrePublishError) Error() string { return e.err.Error() }
+func (e *PrePublishError) Unwrap() error { return e.err }
+
+func IsPrePublishFailure(err error) bool {
+	var target *PrePublishError
+	return errors.As(err, &target)
+}
+
+func PrePublishFailureReason(err error) string {
+	var target *PrePublishError
+	if !errors.As(err, &target) {
+		return ""
+	}
+	return target.reason
+}
+
